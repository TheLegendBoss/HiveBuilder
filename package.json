{
  "name": "hive-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource/saira-semi-condensed": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "phaser": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Hive Deck: a grim-dark deckbuilding campaign game (working title)",
  "author": "DJ Ness",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.thelegendboss.hivedeck",
    "productName": "Hive Deck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "HiveDeck-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "HiveDeck-${version}-portable.exe"
    }
  }
}
